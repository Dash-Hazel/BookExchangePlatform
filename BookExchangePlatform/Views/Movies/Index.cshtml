@model List<BookExchangePlatform.Models.Movie>

<h1>Movies</h1>

<p>
    <a asp-action="Create" class="btn btn-primary btn-outline-info">Create New</a>
</p>

<form method="get" asp-action="Index">
    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search books..." />
    <button type="submit" class="btn btn-primary">Search</button>
</form>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Title</th>
            <th>Director</th>
            <th>Genre</th>
            <th>ReleaseYear</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td>@movie.Title</td>
                <td>@movie.Director</td>
                <td>@movie.Genre</td>
                <td>@movie.ReleaseYear</td>
                <td>@(movie.Owner.FullName)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@movie.Id" class="btn btn-info">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<nav>
    <ul class="pagination">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@i"
                   asp-route-search="@ViewBag.Search">@i</a>
            </li>
        }
    </ul>
</nav>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No movies found. <a asp-action="Create">Create the first movie</a>
    </div>
}